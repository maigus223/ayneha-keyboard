<?xml version="1.0" encoding="utf-8"?>
<!-- Only exposes cacheDir/shared_images — where AynehaShareImage writes its .jpg files —
     nothing else in the app's storage is reachable through the FileProvider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="shared_images" path="shared_images/" />
</paths>
