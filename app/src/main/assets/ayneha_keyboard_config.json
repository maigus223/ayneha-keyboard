{
  "app_architecture": {
    "screen_layout": {
      "top_section": {
        "id": "composition_zone",
        "description": "Zone de composition supérieure en RTL pur (comportement identique au N'Ko ou à l'Arabe).",
        "type": "text_editor_canvas",
        "direction": "rtl",
        "text_alignment": "right",
        "font": {
          "family": "AYNEHA",
          "file": "ayneha_pro.ttf",
          "version": "3.0",
          "role": "transition (ancienne plage U+E000-E061 + nouvelle plage U+10FF7C-U+10FFDD)"
        },
        "features": [
          "live_text_rendering",
          "combining_accents_support",
          "glyph_preview",
          "copy_paste_actions"
        ]
      },
      "bottom_section": {
        "id": "keyboard_zone",
        "description": "Clavier virtuel Android/Web (IME) positionné en bas de l'écran avec rendu physique RTL strict.",
        "layout_ref": "layout_views"
      }
    },
    "ui_theme": {
      "name": "AYNEHA System Theme",
      "colors": {
        "primary_background": "#F4F6F8",
        "composition_bg": "#FFFFFF",
        "keyboard_bg": "#E3E8EC",
        "key_bg_default": "#FFFFFF",
        "key_bg_action": "#CFD8DC",
        "key_bg_pressed": "#B0BEC5",
        "text_primary": "#1A252C",
        "accent_color": "#00838F"
      },
      "styling": {
        "key_corner_radius_dp": 6,
        "key_elevation_dp": 2,
        "font_family_keyboard": "AYNEHA"
      }
    }
  },
  "keyboard_metadata": {
    "name": "AYNEHA Songhay Keyboard",
    "id": "ayneha_songhay_rtl",
    "version": "3.1.0",
    "author": "AYNEHA Project",
    "direction": "rtl",
    "script_family": "pure_rtl_cursive_like",
    "behaviour_model": "NKO_ARABIC_PURE_RTL",
    "total_glyphs": 98,
    "pua_range": {
      "start": "U+10FF7C",
      "end": "U+10FFDD"
    },
    "legacy_pua_range": {
      "start": "U+E000",
      "end": "U+E061"
    },
    "description": "Système d'écriture AYNEHA : Pure RTL (comme le N'Ko et l'Arabe). Premier élément de chaque rangée = touche située physiquement à l'EXTRÊME DROITE de l'écran."
  },
  "features": {
    "rtl_support": true,
    "text_direction": "right-to-left",
    "cursor_behavior": "rtl_biDi_override",
    "long_press_popups": true,
    "haptic_feedback": true,
    "key_preview": true,
    "layouts": [
      "alphabet",
      "symbols_page1",
      "numpad",
      "emoji"
    ]
  },
